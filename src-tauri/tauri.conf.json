{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHDeck",
  "version": "0.8.0",
  "identifier": "com.skuth.sshdeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSHDeck",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#0b0e14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGN0Q2NjFFNEYyQjI1NzEKUldSeEpTdFBIbVo5ajQyTnduZkUyeE5uWS9RZ3p4RndsMlFFSXFMeUNyYnRMU1cweWNDRlVaVFkK",
      "endpoints": [
        "https://github.com/Skuth/sshdeck/releases/latest/download/latest.json"
      ]
    }
  }
}
